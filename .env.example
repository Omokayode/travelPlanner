# Copy this file to .env (used by docker compose) and, for `next dev`, to .env.local.
# Never commit the real files — both are git-ignored. Use letters and digits only in the password
# (it is also embedded in DATABASE_URL).

POSTGRES_USER=tripbyjkblabs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tripbyjkblabs

# For local development outside Docker (next dev):
DATABASE_URL="postgresql://tripbyjkblabs:change-me@localhost:5432/tripbyjkblabs"
